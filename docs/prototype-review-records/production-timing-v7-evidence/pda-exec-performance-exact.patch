+  currentDetailObjectSearchIndex ??= getProductionObjectSearchIndex(true)
+  const resolved = resolveProductionObjectRequest(request, currentDetailObjectSearchIndex)
+  currentDetailObjectRequests.set(key, resolved)
+  return resolved
