 function timingBase(d?: any): any { const k: any = d?.clock; if (!k || !k.sla || !k.start || !Number.isFinite(ms(k.start))) return null; const deadline: any = ms(k.start) + k.sla * DAY, end: any = ms(k.end || ASOF), gap: any = Math.max(0, end - deadline); const done = !!k.end; if (!done && /执行结果待取得|完成事实待取得|状态待核实/.test(d.status || '')) return { deadline, gap: null, done: false, unknown: true, label: '完成事实待取得 · 时效无法判定' }; const endpoint = k.kind === '采购到仓' ? done ? '已入仓' : '未入仓' : k.kind === '交接' ? done ? '已全部接收' : '未全部接收' : done ? '已完成' : '未完成'; return { deadline, gap, done, label: endpoint + (gap ? (done ? ' · 晚' : ' · 已超时') + duration(gap) : done ? ' · 按期' : end < ms(k.start) ? ' · 尚未开始' : ' · 截止未到') }; }
