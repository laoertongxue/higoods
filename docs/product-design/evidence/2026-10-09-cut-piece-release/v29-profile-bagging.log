 return {sample,remark,createMs,paperTabMs,previewMs,printMs,visual:{createVisual,paperTabVisual,previewVisual,printVisual},batchId:created[0].manualBatchId||created[0].sourceOutputLineId.split('-marker-plan-')[0],tickets:printed.map(x=>({id:x.feiTicketId,no:x.feiTicketNo,qty:x.qty,printStatus:x.printStatus,size:x.skuSize,crafts:x.specialCrafts})),originalOrdinary:created.filter(x=>!x.hasSpecialCraft).map(x=>({id:x.feiTicketId,no:x.feiTicketNo,qty:x.qty})),route:page.url()};
}
