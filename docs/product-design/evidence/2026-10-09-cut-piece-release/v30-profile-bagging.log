async function createAndPrint(page, sample, version){
 const remark=`${version}连续工艺正常来源${sample}`;
 await page.setViewportSize({width:1024,height:768});
 await page.goto('http://127.0.0.1:4190/fcs/craft/cutting/fei-tickets');
 await page.getByRole('button',{name:'手动增加打印菲票',exact:true}).waitFor();
 await page.getByRole('button',{name:'手动增加打印菲票',exact:true}).click();
 const d=page.getByRole('dialog',{name:'手动增加打印菲票'});
 await d.locator('[data-cutting-fei-manual-field=markerPlanId]').selectOption('marker-plan-1791559507941-tra25e');
 await d.locator('[data-cutting-fei-manual-size=M]').fill('5');
 await d.locator('[data-cutting-fei-manual-size=XL]').fill('5');
 await d.locator('[data-cutting-fei-manual-field=remark]').fill(remark);
 await d.locator('[data-cutting-fei-manual-field=remark]').blur();
 const ct=await page.evaluate(()=>performance.now());
 await d.getByRole('button',{name:'确认生成菲票',exact:true}).click();
 await d.waitFor({state:'hidden'});
 const records=await readRecords(page,['part-ticket:manual-records']);
 const created=records.map(x=>x.value).filter(x=>x.remark===remark||JSON.stringify(x).includes(remark));
 if(created.length!==8) throw new Error(`manual saved count ${created.length}`);
 const special=created.filter(x=>x.hasSpecialCraft);
 if(special.length!==2)throw new Error('not two genuine special tickets');
 const createVisual=await visualComplete(page);const createMs=await page.evaluate(t=>performance.now()-t,ct);
 await page.locator('tr').nth(1).getByRole('button',{name:'菲票明细',exact:true}).click();
 await page.getByRole('button',{name:'有特殊工艺 · 黄色热敏纸（2）',exact:true}).waitFor();
 const tabT=await page.evaluate(()=>performance.now());
 await page.getByRole('button',{name:'有特殊工艺 · 黄色热敏纸（2）',exact:true}).click();
 await page.getByRole('button',{name:'全部打印（2）',exact:true}).waitFor();
 const paperTabVisual=await visualComplete(page);const paperTabMs=await page.evaluate(t=>performance.now()-t,tabT);
 await page.getByRole('button',{name:'全部打印（2）',exact:true}).click();
 await page.getByRole('button',{name:'已装入黄色热敏纸，进入预览',exact:true}).waitFor();
 const pt=await page.evaluate(()=>performance.now());
 await page.getByRole('button',{name:'已装入黄色热敏纸，进入预览',exact:true}).click();
 await page.locator('[data-print-preview-action=print]').waitFor();
 await page.locator('[data-real-qr] svg').first().waitFor();
 await page.locator('img').evaluateAll(es=>Promise.all(es.map(e=>e.complete?Promise.resolve():new Promise(r=>{e.onload=r;e.onerror=r}))));
 const previewVisual=await visualComplete(page);const previewMs=await page.evaluate(t=>performance.now()-t,pt);
 const printT=await page.evaluate(()=>performance.now());
 await page.locator('[data-print-preview-action=print]').click();
 let printed;
 for(let n=0;n<100;n++){
  const rs=await readRecords(page,['part-ticket:manual-records']);
  printed=rs.map(x=>x.value).filter(x=>special.some(s=>s.feiTicketId===x.feiTicketId));
  if(printed.length===2&&printed.every(x=>x.printStatus==='PRINTED'))break;
  await page.waitForTimeout(10);
 }
 if(!printed||!printed.every(x=>x.printStatus==='PRINTED'))throw new Error('original print not durable');
 const printVisual=await visualComplete(page);const printMs=await page.evaluate(t=>performance.now()-t,printT);
 return {sample,remark,createMs,paperTabMs,previewMs,printMs,visual:{createVisual,paperTabVisual,previewVisual,printVisual},batchId:created[0].manualBatchId||created[0].sourceOutputLineId.split('-marker-plan-')[0],tickets:printed.map(x=>({id:x.feiTicketId,no:x.feiTicketNo,qty:x.qty,printStatus:x.printStatus,size:x.skuSize,crafts:x.specialCrafts})),originalOrdinary:created.filter(x=>!x.hasSpecialCraft).map(x=>({id:x.feiTicketId,no:x.feiTicketNo,qty:x.qty})),route:page.url()};
}
async function saveDialogAction(page,m,name,bagCode){
 const t=await page.evaluate(()=>performance.now());await m.getByRole('button',{name,exact:true}).click();await m.getByRole('button',{name:'已保存',exact:true}).waitFor({timeout:8000});
 const read=(await readRecords(page,['cutting-events'])).map(x=>x.value).filter(e=>e.refs?.transferBagCode===bagCode);
 const visual=await visualComplete(page);return {visual,ms:await page.evaluate(t=>performance.now()-t,t),body:await m.innerText(),events:read};
}
